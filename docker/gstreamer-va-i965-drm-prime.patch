va: import DMA buffers as DRM_PRIME when the driver doesn't support DRM_PRIME_2

The i965 driver only supports DRM_PRIME import: with DRM_PRIME_2 it returns
an empty surface without error (black screen with zero copy).
See https://github.com/games-on-whales/wolf/pull/585

diff --git a/subprojects/gst-plugins-bad/gst-libs/gst/va/vasurfaceimage.c b/subprojects/gst-plugins-bad/gst-libs/gst/va/vasurfaceimage.c
index 326e637..1a3106d 100644
--- a/subprojects/gst-plugins-bad/gst-libs/gst/va/vasurfaceimage.c
+++ b/subprojects/gst-plugins-bad/gst-libs/gst/va/vasurfaceimage.c
@@ -63,6 +63,47 @@ _rt_format_is_rgb (guint rt_format)
   return FALSE;
 }
 
+/* Some drivers (i965) don't support DRM_PRIME_2 import and return an empty
+ * surface instead of an error. Check what the driver advertises, once per
+ * display. */
+static gboolean
+va_supports_drm_prime_2 (GstVaDisplay * display)
+{
+  GQuark quark = g_quark_from_static_string ("GstVaSupportsDrmPrime2");
+  VADisplay dpy = gst_va_display_get_va_dpy (display);
+  VASurfaceAttrib *attrs;
+  VAConfigID config;
+  guint i, num_attrs = 0;
+  gboolean supported = TRUE;
+  gpointer cached;
+
+  cached = g_object_get_qdata (G_OBJECT (display), quark);
+  if (cached)
+    return GPOINTER_TO_INT (cached) == 2;
+
+  if (vaCreateConfig (dpy, VAProfileNone, VAEntrypointVideoProc, NULL, 0,
+          &config) == VA_STATUS_SUCCESS) {
+    if (vaQuerySurfaceAttributes (dpy, config, NULL,
+            &num_attrs) == VA_STATUS_SUCCESS && num_attrs > 0) {
+      attrs = g_new (VASurfaceAttrib, num_attrs);
+      if (vaQuerySurfaceAttributes (dpy, config, attrs,
+              &num_attrs) == VA_STATUS_SUCCESS) {
+        for (i = 0; i < num_attrs; i++) {
+          if (attrs[i].type == VASurfaceAttribMemoryType)
+            supported = (attrs[i].value.value.i &
+                VA_SURFACE_ATTRIB_MEM_TYPE_DRM_PRIME_2) != 0;
+        }
+      }
+      g_free (attrs);
+    }
+    vaDestroyConfig (dpy, config);
+  }
+
+  g_object_set_qdata (G_OBJECT (display), quark,
+      GINT_TO_POINTER (supported ? 2 : 1));
+  return supported;
+}
